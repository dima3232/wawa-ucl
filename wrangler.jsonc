{
  "name": "wawa-ucl",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // власний KV цього проєкту (ключі з префіксом "ucl:")
  "kv_namespaces": [
    { "binding": "UCL_KV", "id": "badae86725984c3ab08a1ed7ecfe5e04" }
  ],
  // ключ Highlightly зі спільного Secrets Store (значення не в репозиторії)
  "secrets_store_secrets": [
    { "binding": "HIGHLIGHTLY_KEY", "store_id": "ed8c1e4b8aa24976844b6ada365fa834", "secret_name": "HIGHLIGHTLY_KEY" }
  ],
  // зона challango.com у цьому ж акаунті, тож домен підключається нативно
  "routes": [
    { "pattern": "ucl2627.challango.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["*/3 * * * *"]
  }
}
